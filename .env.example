# =============================================================================
#  Freegma configuration
#  Copy to .env (`make init` does this and fills in random secrets).
#  Never commit .env - it contains secrets.
# =============================================================================

# --- Versions ----------------------------------------------------------------
# Penpot release used for all penpot* images (https://github.com/penpot/penpot/releases).
# Upgrade with: make update VERSION=x.y.z
PENPOT_VERSION=2.18.3
# Freegma branding-proxy image. Published to GHCR and Docker Hub:
#   ghcr.io/julianhintermann-cmd/freegma   |   docker.io/<dockerhub-user>/freegma
FREEGMA_IMAGE=ghcr.io/julianhintermann-cmd/freegma
FREEGMA_VERSION=1.0.0

# --- Address -----------------------------------------------------------------
# Hostname users type into the browser. Must resolve to your server
# (local DNS record, router, Pi-hole, AdGuard, /etc/hosts, Tailscale MagicDNS ...).
FREEGMA_DOMAIN=freegma.home.arpa
# Full public URL incl. scheme (and port if not 443). Penpot uses it for links,
# exports and the MCP server URL shown under Account -> Integrations.
FREEGMA_PUBLIC_URI=https://freegma.home.arpa

# Which optional services to run (comma separated):
#   https   - Caddy terminates HTTPS on FREEGMA_HTTPS_PORT (recommended)
#   mailpit - local mail catcher for testing, UI on 127.0.0.1:8025
# Leave "https" out if you already run a reverse proxy; point it at
# FREEGMA_HTTP_BIND:FREEGMA_HTTP_PORT and set FREEGMA_HTTP_BIND=0.0.0.0.
COMPOSE_PROFILES=https

# --- TLS (profile "https") ----------------------------------------------------
# "internal"          -> Caddy's own CA (LAN/Tailscale; trust the root once, see README)
# "you@example.com"   -> Let's Encrypt via HTTP/TLS-ALPN challenge (needs public reachability)
FREEGMA_TLS=internal
FREEGMA_HTTPS_BIND=0.0.0.0
FREEGMA_HTTPS_PORT=443
FREEGMA_HTTP_REDIRECT_PORT=80

# --- Plain HTTP port of the branding proxy ------------------------------------
# 127.0.0.1 = only reachable from the host itself (Caddy uses the internal network).
FREEGMA_HTTP_BIND=127.0.0.1
FREEGMA_HTTP_PORT=9001

# --- Branding ------------------------------------------------------------------
# Logo, favicon, CSS and UI texts live in ./branding (see docs/BRANDING.md).
FREEGMA_BRAND_NAME=Freegma
# Accent colours for the dark (default) and light UI themes. Empty = branding/freegma.css defaults.
FREEGMA_ACCENT_DARK=
FREEGMA_ACCENT_LIGHT=
# Replace "Penpot" in selected UI texts (branding/text-replacements.tsv).
FREEGMA_REBRAND_TEXT=true
# Show "Freegma - based on Penpot (MPL-2.0)" on login/dashboard. Keep it on
# when you distribute the app; it is how Freegma credits Penpot.
FREEGMA_SHOW_ATTRIBUTION=true
FREEGMA_SOURCE_URL=https://github.com/julianhintermann-cmd/Freegma

# --- Secrets (generated by `make init`) ------------------------------------------
PENPOT_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_USER=penpot
POSTGRES_DB=penpot

# --- Penpot options ------------------------------------------------------------
# Extra Penpot flags appended to the defaults in docker-compose.yml, e.g.
#   enable-smtp                 send real email (configure SMTP below)
#   enable-log-invitation-tokens print invitation links to the backend log
#   enable-access-tokens        personal API tokens (Account -> Integrations)
#   enable-webhooks
# Reference: https://help.penpot.app/technical-guide/configuration/
PENPOT_EXTRA_FLAGS=enable-access-tokens
PENPOT_TELEMETRY_ENABLED=false
# Extra JVM flags for the backend. The JVM sizes its heap from host RAM
# (~1.5-2 GB on a 16 GB host). On small NAS boxes cap it, e.g. -Xmx1g.
PENPOT_JVM_OPTS=
# Max upload size in bytes (default 350 MiB).
PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600
# Set to true on hosts where IPv6 is disabled at kernel level (some NAS systems).
PENPOT_DISABLE_IPV6_LISTEN=false

# --- Email (optional) --------------------------------------------------------------
# Defaults point at the "mailpit" profile. For real mail add enable-smtp to
# PENPOT_EXTRA_FLAGS and fill these in.
PENPOT_SMTP_DEFAULT_FROM=no-reply@freegma.local
PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@freegma.local
PENPOT_SMTP_HOST=penpot-mailpit
PENPOT_SMTP_PORT=1025
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_TLS=false
PENPOT_SMTP_SSL=false

# --- MCP ------------------------------------------------------------------------------
# Filled in by `make mcp-token` (stores the MCP key of the MCP user).
# Treat like a password: anyone with it can drive your open Penpot tab.
FREEGMA_MCP_USER_EMAIL=
FREEGMA_MCP_TOKEN=
PENPOT_MCP_LOG_LEVEL=info
PENPOT_MCP_TOOL_TIMEOUT_S=120

# --- Backups --------------------------------------------------------------------------
# Target directory on the host (e.g. a NAS share). Rotation: 7 daily, 4 weekly.
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
